{
  "name": "@algorandfoundation/algokit-utils",
  "version": "9.2.3-beta.1",
  "private": false,
  "description": "A set of core Algorand utilities written in TypeScript and released via npm that make it easier to build solutions on Algorand.",
  "author": "Algorand Foundation",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/algorandfoundation/algokit-ts.git",
    "directory": "algokit-utils-ts"
  },
  "engines": {
    "node": ">=22.0"
  },
  "type": "commonjs",
  "main": "index.js",
  "module": "index.mjs",
  "types": "index.d.ts",
  "files": [
    "**/*"
  ],
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.mjs",
      "require": "./index.js"
    },
    "./types/*": {
      "types": "./types/*.d.ts",
      "import": "./types/*.mjs",
      "require": "./types/*.js"
    },
    "./testing": {
      "types": "./testing/index.d.ts",
      "import": "./testing/index.mjs",
      "require": "./testing/index.js"
    },
    "./index.d.ts": "./index.d.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "run-s build:*",
    "build:0-clean": "rimraf dist coverage",
    "build:1-compile": "rolldown -c",
    "build:2-emit-types": "tsc --project tsconfig.build.json --emitDeclarationOnly",
    "build:3-copy-pkg-json": "tsx ../tooling/copy-package-json.ts",
    "build:4-copy-readme": "cpy README.md LICENSE dist",
    "build:5-fix-readme-links": "replace-in-files --string '(./' --replacement '(https://github.com/algorandfoundation/algokit-ts/blob/main/algokit-utils-ts/' dist/README.md",
    "build:6-check-dist-types": "tsc --project tsconfig.dist-check.json",
    "test": "vitest run --coverage --passWithNoTests",
    "test:watch": "vitest watch --coverage --passWithNoTests",
    "check-types": "tsc --noEmit",
    "audit": "pnpm --filter . audit",
    "format": "prettier --write . --ignore-path ../.gitignore --ignore-path .gitignore --ignore-path ../.prettierignore",
    "lint": "eslint ./src/",
    "lint:fix": "eslint ./src/ --fix",
    "pre-commit": "run-s check-types lint:fix audit format test",
    "docs:dev": "pnpm --dir docs run dev",
    "docs:build": "pnpm --dir docs run build",
    "docs:preview": "pnpm --dir docs run preview"
  },
  "dependencies": {
    "buffer": "catalog:"
  },
  "peerDependencies": {
    "algosdk": "^3.5.2"
  },
  "devDependencies": {
    "@algorandfoundation/tealscript": "catalog:",
    "@types/json-bigint": "catalog:",
    "@types/node": "catalog:",
    "@types/uuid": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "cpy-cli": "catalog:",
    "eslint": "catalog:",
    "npm-run-all2": "catalog:",
    "prettier": "catalog:",
    "replace-in-files-cli": "catalog:",
    "rimraf": "catalog:",
    "rolldown": "catalog:",
    "tiny-invariant": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "uuid": "catalog:",
    "vitest": "catalog:",
    "vitest-fetch-mock": "catalog:"
  },
  "publishConfig": {
    "directory": "dist",
    "linkDirectory": true
  }
}
