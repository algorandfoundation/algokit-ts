// Shared compiler options. Each package's tsconfig.json extends this and adds its own `include`.
{
  "extends": "@tsconfig/node22/tsconfig.json",
  "compilerOptions": {
    "module": "ESNext",
    "target": "ES2022",
    "moduleResolution": "Bundler",
    "esModuleInterop": true,
    "lib": ["ES2022", "dom"],
    "types": ["node"],
    "declaration": true,
    "importHelpers": true,
    "isolatedModules": true,
    "resolveJsonModule": true
  }
}
