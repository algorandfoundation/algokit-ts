{
  "extends": "../tooling/tsconfig.base.json",
  "compilerOptions": {
    // Node-only CLI and generator, so no DOM types (their `Crypto` conflicts with node's `webcrypto` in the examples)
    "lib": ["ES2024"]
  },
  "include": ["src/**/*.ts", "examples/**/*.ts", "scripts/**/*.ts", "*.config.ts"],
  "exclude": ["examples/**/*.algo.ts"]
}
