{
  "name": "@algorandfoundation/algokit-subscriber",
  "version": "3.4.0",
  "private": false,
  "scripts": {
    "build": "run-s build:*",
    "build:0-clean": "rimraf dist coverage",
    "build:1-compile": "rolldown -c",
    "build:2-emit-types": "tsc --project tsconfig.build.json --emitDeclarationOnly",
    "build:3-copy-pkg-json": "tsx ../tooling/copy-package-json.ts",
    "build:4-copy-readme": "cpy README.md LICENSE.md dist",
    "build:5-fix-readme-links": "replace-in-files --string '(./' --replacement '(https://github.com/algorandfoundation/algokit-ts/blob/main/algokit-subscriber-ts/' dist/README.md",
    "build:6-check-dist-types": "tsc --project tsconfig.dist-check.json",
    "test": "vitest run --coverage --passWithNoTests",
    "test:watch": "vitest watch --coverage --passWithNoTests",
    "check-types": "tsc --noEmit",
    "audit": "pnpm --filter . audit",
    "format": "prettier --write . --ignore-path ../.gitignore --ignore-path .gitignore --ignore-path ../.prettierignore",
    "lint": "eslint ./src/",
    "lint:fix": "eslint ./src/ --fix",
    "pre-commit": "run-s check-types lint:fix audit format test docs:build",
    "postinstall": "prisma generate",
    "docs:dev": "pnpm --dir docs run dev",
    "docs:build": "pnpm --dir docs run build",
    "docs:preview": "pnpm --dir docs run preview",
    "generate:contract-client": "cd tests/contract && poetry run python -m build",
    "dhm": "ts-node-dev --project tsconfig.dev.json --transpile-only --watch .env -r dotenv/config ./examples/data-history-museum/index.ts",
    "watch-dhm": "cross-env RUN_LOOP=true pnpm run dhm",
    "xgov": "pnpm exec prisma migrate dev && ts-node-dev --project tsconfig.dev.json --transpile-only --watch .env -r dotenv/config ./examples/xgov-voting/index.ts",
    "watch-xgov": "cross-env RUN_LOOP=true pnpm run xgov",
    "usdc": "ts-node-dev --project tsconfig.dev.json --transpile-only --watch .env -r dotenv/config ./examples/usdc/index.ts"
  },
  "prisma": {
    "schema": "examples/xgov-voting/prisma/schema.prisma"
  },
  "author": "Algorand Foundation",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/algorandfoundation/algokit-ts.git",
    "directory": "algokit-subscriber-ts"
  },
  "engines": {
    "node": ">=22.0"
  },
  "type": "commonjs",
  "main": "index.js",
  "module": "index.mjs",
  "types": "index.d.ts",
  "files": [
    "**/*"
  ],
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.mjs",
      "require": "./index.js"
    },
    "./block": {
      "types": "./block.d.ts",
      "import": "./block.mjs",
      "require": "./block.js"
    },
    "./transform": {
      "types": "./transform.d.ts",
      "import": "./transform.mjs",
      "require": "./transform.js"
    },
    "./types/*": {
      "types": "./types/*.d.ts",
      "import": "./types/*.mjs",
      "require": "./types/*.js"
    },
    "./index.d.ts": "./index.d.ts",
    "./package.json": "./package.json"
  },
  "devDependencies": {
    "@algorandfoundation/algokit-client-generator": "workspace:*",
    "@algorandfoundation/algokit-utils": "workspace:*",
    "@prisma/client": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "cpy-cli": "catalog:",
    "cross-env": "catalog:",
    "dotenv-cli": "catalog:",
    "eslint": "catalog:",
    "npm-run-all2": "catalog:",
    "prettier": "catalog:",
    "prisma": "catalog:",
    "replace-in-files-cli": "catalog:",
    "rimraf": "catalog:",
    "rolldown": "catalog:",
    "tiny-invariant": "catalog:",
    "ts-node-dev": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "dependencies": {
    "js-sha512": "catalog:"
  },
  "peerDependencies": {
    "@algorandfoundation/algokit-utils": "^9.0.0",
    "algosdk": "^3.8.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
